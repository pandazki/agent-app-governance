# Generated apps stay out of the repository; the directory itself is kept so that it exists,
# owned by you, before Docker mounts it (Docker would otherwise create it as root). Its marker tells the Host it
# sees this folder, not one Docker made (src/apps-folder.ts).
apps/*
!apps/.appgov-host-folder
node_modules/
.env
.env.*
!.env.example
# pneuma-framework's source, fetched by `bun run setup` at the commit compose.yaml pins.
vendor/
